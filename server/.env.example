DATABASE_URL=postgresql://user:password@localhost:5432/song_notebook
JWT_SECRET=your-secret-key-here
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development
GOOGLE_CLIENT_ID=your-google-client-id
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
APP_URL=http://localhost:5173

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
OPENAI_API_KEY=sk-your-openai-api-key   # optional — only needed for GPT-4o-mini

VOYAGE_API_KEY=pa-your-voyage-api-key

# LiteLLM proxy (run via docker-compose up litellm)
LITELLM_MASTER_KEY=sk-wordchord-local
LITELLM_PROXY_URL=http://localhost:4000


# LangSmith observability (optional — tracing is disabled when not set)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-langsmith-api-key
LANGCHAIN_PROJECT=wordchord

# Grafana Loki (optional — logs are console-only when not set)
LOKI_HOST=https://logs-prod-XXX.grafana.net
LOKI_BASIC_AUTH=<userId>:<apiKey>
